{
  "$defs": {
    "AttackResult": {
      "additionalProperties": false,
      "properties": {
        "atlas_ids": {
          "items": {
            "type": "string"
          },
          "title": "Atlas Ids",
          "type": "array"
        },
        "attack_type": {
          "minLength": 1,
          "title": "Attack Type",
          "type": "string"
        },
        "canonical_result": {
          "additionalProperties": true,
          "title": "Canonical Result",
          "type": "object"
        },
        "cwe_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cwe Ids",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "evaluation_methodology": {
          "default": "canonical_only",
          "title": "Evaluation Methodology",
          "type": "string"
        },
        "heuristic_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Heuristic Score",
          "type": "number"
        },
        "judge_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge Score"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "module_id": {
          "minLength": 1,
          "title": "Module Id",
          "type": "string"
        },
        "module_version": {
          "default": "1.0.0",
          "title": "Module Version",
          "type": "string"
        },
        "owasp_ids": {
          "items": {
            "type": "string"
          },
          "title": "Owasp Ids",
          "type": "array"
        },
        "payload": {
          "minLength": 1,
          "title": "Payload",
          "type": "string"
        },
        "payload_id": {
          "default": "unknown",
          "title": "Payload Id",
          "type": "string"
        },
        "raw_response": {
          "default": "",
          "title": "Raw Response",
          "type": "string"
        },
        "risk_score": {
          "default": 0.0,
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Risk Score",
          "type": "number"
        }
      },
      "required": [
        "module_id",
        "attack_type",
        "payload"
      ],
      "title": "AttackResult",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "atlas_ids": {
          "items": {
            "type": "string"
          },
          "title": "Atlas Ids",
          "type": "array"
        },
        "base_score": {
          "default": 1.0,
          "maximum": 10.0,
          "minimum": 1.0,
          "title": "Base Score",
          "type": "number"
        },
        "confidence_score": {
          "maximum": 0.92,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "cwe_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cwe Ids",
          "type": "array"
        },
        "deployment_context": {
          "default": "default",
          "title": "Deployment Context",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evaluation_methodology": {
          "default": "deterministic_static",
          "title": "Evaluation Methodology",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "owasp_ids": {
          "items": {
            "type": "string"
          },
          "title": "Owasp Ids",
          "type": "array"
        },
        "remediation": {
          "default": "",
          "title": "Remediation",
          "type": "string"
        },
        "risk_score": {
          "default": 0.0,
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Risk Score",
          "type": "number"
        },
        "rule_id": {
          "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+$",
          "title": "Rule Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "severity",
        "title",
        "description",
        "confidence_score"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ReportMetadata": {
      "additionalProperties": false,
      "properties": {
        "argus_version": {
          "default": "0.2.1",
          "title": "Argus Version",
          "type": "string"
        },
        "dataset_version": {
          "default": "1.1.0",
          "title": "Dataset Version",
          "type": "string"
        },
        "generated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "profile": {
          "default": "default",
          "title": "Profile",
          "type": "string"
        },
        "scan_id": {
          "title": "Scan Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "local",
            "git"
          ],
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "source_type",
        "source",
        "scan_id"
      ],
      "title": "ReportMetadata",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attack_results": {
      "items": {
        "$ref": "#/$defs/AttackResult"
      },
      "title": "Attack Results",
      "type": "array"
    },
    "configuration": {
      "additionalProperties": true,
      "title": "Configuration",
      "type": "object"
    },
    "evaluation_methodology": {
      "default": "canonical_only",
      "title": "Evaluation Methodology",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/ReportMetadata"
    },
    "summary": {
      "additionalProperties": true,
      "title": "Summary",
      "type": "object"
    }
  },
  "required": [
    "metadata"
  ],
  "title": "ScanReport",
  "type": "object"
}
