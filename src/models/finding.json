{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Finding",
  "description": "Structured output from a static scanner",
  "type": "object",
  "required": ["rule_id", "severity", "title", "description", "confidence_score", "evidence"],
  "properties": {
    "rule_id": { "type": "string" },
    "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 0.92,
      "description": "Never 1.0 — auditors distrust absolute certainty"
    },
    "evidence": { "type": "object" },
    "evaluation_methodology": { "type": "string" }
  }
}
