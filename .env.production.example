# Production topology: Caddy terminates TLS and load-balances gateway replicas.
# Set DNS for ARGUS_DOMAIN to this host and allow inbound ports 80/443.
ARGUS_DOMAIN=assistant.example.edu
ARGUS_HTTP_PORT=80
ARGUS_HTTPS_PORT=443

# The upstream must be reachable from the runtime containers.
ARGUS_RUNTIME_UPSTREAM_URL=https://model.internal/v1/messages

# Generate unique random values. Never commit the populated file.
ARGUS_RUNTIME_CLIENT_TOKEN=
ARGUS_RUNTIME_APPROVAL_SERVICE_URL=https://approvals.internal/v1/decisions
ARGUS_RUNTIME_APPROVAL_SERVICE_TOKEN=
ARGUS_RUNTIME_AUDIT_KEY=
ARGUS_RUNTIME_AUDIT_SINK_URL=https://audit.internal/v1/events
ARGUS_RUNTIME_AUDIT_SINK_TOKEN=
