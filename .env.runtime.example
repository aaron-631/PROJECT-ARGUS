# Copy this file to .env.runtime and replace every placeholder before starting
# docker-compose.runtime.yml. Do not commit the copied file.
ARGUS_RUNTIME_UPSTREAM_URL=http://host.docker.internal:9000/v1/messages
ARGUS_RUNTIME_PORT=8080
# Client authentication is enabled by default in the reusable deployment.
ARGUS_RUNTIME_REQUIRE_CLIENT_AUTH=true
ARGUS_RUNTIME_CLIENT_TOKEN=
ARGUS_RUNTIME_APPROVAL_TOKEN=
ARGUS_RUNTIME_AUDIT_KEY=
# Optional external approval and audit collector endpoints.
ARGUS_RUNTIME_APPROVAL_SERVICE_URL=
ARGUS_RUNTIME_APPROVAL_SERVICE_TOKEN=
ARGUS_RUNTIME_AUDIT_SINK_URL=
ARGUS_RUNTIME_AUDIT_SINK_TOKEN=
