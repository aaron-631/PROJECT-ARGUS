# Copy this file to .env.runtime and replace every placeholder before starting
# docker-compose.runtime.yml. Do not commit the copied file.
ARGUS_RUNTIME_UPSTREAM_URL=http://host.docker.internal:9000/v1/messages
ARGUS_RUNTIME_PORT=8080
# Leave these empty for a first run, or inject real random values from a secret manager.
ARGUS_RUNTIME_APPROVAL_TOKEN=
ARGUS_RUNTIME_AUDIT_KEY=
